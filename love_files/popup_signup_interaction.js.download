DT.onReadyIdle(()=>{const SEARCH_TYPING_THRESHOLD_MS=1500;const POPUP_INITIAL_DELAY_MS=1000;const POPUP_RETRY_DELAY_MS=500;let lastSearchInputTime=null;let isDepsLoaded=!1;let popupTimeoutId=null;const searchField=document.querySelector('#srh_field');const schedulePopupAttempt=(delay=POPUP_RETRY_DELAY_MS)=>{clearTimeout(popupTimeoutId);popupTimeoutId=setTimeout(tryShowSignupPopup,delay)};const isTypingInSearch=()=>(lastSearchInputTime!==null&&((Date.now()-lastSearchInputTime)<SEARCH_TYPING_THRESHOLD_MS));const shouldDelayPopup=()=>{const isHeaderHero=document.querySelector('.js-header-hero')!==null;const headerSearchDropdown=document.querySelector('.js-h-search-drop-wrapper');return(isHeaderHero&&(isTypingInSearch()||DT.UI.is(headerSearchDropdown,'opened')))};const tryShowSignupPopup=async()=>{await DT.Scheduler.yieldIfInputPending();const element=document.querySelector('.js-signup-popup-interaction');if(!element)return;if(document.querySelector('#popup-signup'))return;if(shouldDelayPopup()){schedulePopupAttempt();return}
if(!isDepsLoaded){const deps=JSON.parse(element.getAttribute('data-deps'));const parsedDeps=DT.parseLazyDeps(deps);await DT.createLoadDeps(DT.collectDeps(parsedDeps),'high')();isDepsLoaded=!0;await DT.Scheduler.yieldIfInputPending();if(document.querySelector('#popup-signup'))return;if(shouldDelayPopup()){schedulePopupAttempt();return}}
SignUPPopup_load_new(undefined,async()=>{await DT.loadScripts('js/register.js')})};if(searchField){searchField.addEventListener('input',()=>{lastSearchInputTime=Date.now()})}
schedulePopupAttempt(POPUP_INITIAL_DELAY_MS)})