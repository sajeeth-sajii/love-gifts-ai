async function FreeTrial_load_new(){window.openfreetrial=1;DT.addPreloadLink({href:'https://thumbs.dreamstime.com/img/popup_free_trial.jpg',as:'image',});await DT.Scheduler.waitForHighPriority();return popup_loader_new('ajax/freetrialpopup2.php','freetrial_popup')}
function FreeTrial_close(){return popup_close()}
DT.PopupFreeTrial={offset(el){const box=el.getBoundingClientRect();const docElem=document.documentElement;const scrollX=window.pageXOffset;const scrollY=window.pageYOffset;const clientTop=docElem.clientTop;const clientLeft=docElem.clientLeft;const left=box.left+scrollX-clientLeft;const right=box.right+scrollX-clientLeft;return{width:box.width,top:box.top+scrollY-clientTop,left,right,inlineStart:DT.isRtl?right:left,inlineEnd:DT.isRtl?left:right,}},async onMouseLeave(event){const from=event.relatedTarget||event.toElement;const loginActions=document.querySelector('.js-loginactions-wrapper');if((!from||from.nodeName=="HTML")&&event.clientY<=100&&loginActions!==null){const loginActionsOffset=DT.PopupFreeTrial.offset(loginActions);if((loginActionsOffset.left>event.clientX||event.clientX>loginActionsOffset.left+loginActionsOffset.width||event.clientY<=5)&&openfreetrial==0&&(typeof(discountonleave)=="undefined"||discountonleave==0)){if(document.querySelector('.jconfirm-popup-signup-v1')===null&&document.querySelector('.popup')===null){document.body.removeEventListener('mouseleave',DT.PopupFreeTrial.onMouseLeave);FreeTrial_load_new()}}}},init(){document.body.addEventListener('mouseleave',DT.PopupFreeTrial.onMouseLeave)}};DT.PopupFreeTrial.init()