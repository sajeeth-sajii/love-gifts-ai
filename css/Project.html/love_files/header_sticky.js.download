DT.onReady(()=>{const header=document.querySelector('.js-header');const headerSearch=document.querySelector('.js-header-search');const probe=document.createElement('div');probe.style.cssText='position:absolute;visibility:hidden;top:var(--header-sticky-offset-start,0px);';let observer;let offset=-1;const hasBannerStickyTop=()=>{return document.querySelector('.js-banner[data-top-sticky]')!==null};const getOffset=()=>{if(!hasBannerStickyTop()){return 0}
document.body.appendChild(probe);const newOffset=probe.offsetTop;probe.remove();return newOffset};const build=()=>{const newOffset=getOffset();if(newOffset===offset){return}
offset=newOffset;observer?.disconnect();observer=new IntersectionObserver(async()=>{await DT.yieldIfInputPending();const shouldBeSticky=headerSearch.getBoundingClientRect().top<offset;if(shouldBeSticky===DT.UI.is(header,'sticky')){return}
DT.UI.toggle(header,'sticky')},{threshold:1.0,rootMargin:`-${offset}px 0px 0px 0px`},);observer.observe(headerSearch)};build();window.addEventListener('resize',build,{passive:!0})})